# ========================================
# 沖ダイブ・パートナー 環境変数
# cp .env.local.example .env.local して値を記入
# ========================================

# ── スタッフ認証（必須）──────────────────────────────────
# 書式: "メール:パスワード|メール2:パスワード2"
# 最初の : でメールとパスワードを区切る。パスワード内の : は全体を照合する。
# | はアカウント間の区切りのためパスワードに使用不可。設定値の前後空白は除去する。
# 空・不正エントリは除外され、有効な組が0件ならログインを拒否する（503）。
STAFF_CREDENTIALS=staff@okidive.com:your_password

# STAFF_CREDENTIALSからDBへ移行する際、最初の管理者にするメールアドレス
# DB認証を使う場合は必ず既存の管理者1名を指定する。
STAFF_ADMIN_EMAIL=staff@okidive.com

# JWT 署名キー（必須）— ランダムな長い文字列を指定
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_random_32bytes_hex

# スタッフ登録完了メール（Resend）。本番では送信元ドメインを認証する。
# 未設定でもアカウントは作成されるが、登録案内メールは送信されない。
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=沖ダイブ・パートナー <noreply@example.com>
APP_BASE_URL=http://127.0.0.1:3030

# Sheetsの初期化・移行を開発環境で明示的に行う場合だけ true にする。
# スタッフのログインが必要。本番ビルドでは true でもAPIは実行できない。
ENABLE_SHEETS_SETUP=false

# ── PostgreSQL（DB基盤。DBストアへの切替後に必須）───────────────
# ローカル例。ホスティング環境ではプロバイダーのSSL付き接続URLを設定する。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oki_dive
# Sheets同期・予約受付メールのcronを保護する共有シークレット。
# CRON_SECRET=replace_with_random_long_secret

# ── Google Sheets API（任意）────────────────────────────
# 設定しない場合はモックデータで動作します
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_sa@your_project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id

# Sheetsへの全書込を複数インスタンス間で排他するFirestoreプロジェクト
# (default)データベースとサービスアカウントのDatastore User権限が必要
# 同じスプレッドシートを使う全インスタンスで同じプロジェクトを指定
GOOGLE_DATASTORE_LOCK_PROJECT_ID=your_lock_project_id

# ローカルJSON保存先（省略時はプロジェクト内のdata）
# LOCAL_DATA_DIR=C:/path/to/local-data

# ── Google Forms 予約取込（任意）───────────────────────────
# 上記スプレッドシートに紐づくフォーム回答タブ名
GOOGLE_FORM_RESPONSES_SHEET=フォームの回答 1
# 回答先が別スプレッドシートの場合のみ指定（既定は GOOGLE_SPREADSHEET_ID）
# GOOGLE_FORM_SPREADSHEET_ID=your_form_response_spreadsheet_id
# 見出しが標準名と異なる場合のみJSONで指定（任意）
# GOOGLE_FORM_HEADER_MAP={"date":"希望日","time":"希望時間","course":"コース","guestName":"お名前","guestCount":"人数","phone":"電話番号","notes":"備考"}

